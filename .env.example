# ==========================================
# ProjectFlow - Environment Variables Template (.env.example)
# ==========================================

# 1. Environment & Network
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_API_URL=/api/v1
FRONTEND_URL=http://localhost:3000

# 2. Database Connection (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://username:password@localhost:5432/dbname?schema=public"

# 3. Authentication & Security (JWT)
JWT_SECRET="your-super-secret-jwt-key-replace-with-random-string"
JWT_EXPIRES_IN="7d"

# 4. SMTP / Email Configuration (Optional - for password resets)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@example.com"

# 5. Super Admin Initial Account (Used when running: npm run prisma:seed)
SUPER_ADMIN_NAME="Admin User"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="YourSecurePassword123!"
